# Copy outside the repository (or to an ignored build/ path); chmod 600.
# Generate each secret independently with: python3 -c 'import secrets; print(secrets.token_hex(32))'
# The database application password must be URL-safe (hex as above).
MERIDIAN_DOMAIN=localhost
MERIDIAN_SECRET_KEY=
MERIDIAN_DATABASE_ADMIN_PASSWORD=
MERIDIAN_DATABASE_PASSWORD=
MERIDIAN_REGISTRATION_OPEN=1
# Set immutable release tags for deployment; keep defaults for local builds.
MERIDIAN_API_IMAGE=meridian-workspace-api:local
MERIDIAN_WEB_IMAGE=meridian-workspace-web:local
MERIDIAN_WORKER_IMAGE=meridian-workspace-worker:local
# Enable only after the pinned runtime/data and bounded scratch are installed.
# Start the worker explicitly with the Compose profile: --profile compute.
MERIDIAN_EXECUTION_ENABLED=0
# Host socket group from: stat -c %g /var/run/docker.sock
MERIDIAN_DOCKER_GID=0
# Bind sources and targets must be identical absolute paths on this Docker host.
MERIDIAN_VIO_PREPARED=/srv/meridian-workspace/data/room1
MERIDIAN_JOB_ARTIFACT_ROOT=/srv/meridian-workspace/jobs
MERIDIAN_JOB_SCRATCH_ROOT=/srv/meridian-workspace/scratch
# API-only mount target, enabled by compose.investigation.yaml. Source camera
# directories derive from MERIDIAN_VIO_PREPARED; no reference/IMU tree is mounted.
MERIDIAN_CAMERA_ROOT=/reference-cameras
# Admission policy; the immutable estimator resource budget does not change.
MERIDIAN_MIN_AVAILABLE_MEMORY_MB=5120
MERIDIAN_MIN_FREE_DISK_GB=10
