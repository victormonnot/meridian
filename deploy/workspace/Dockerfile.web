FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS build
WORKDIR /app/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/index.html web/workspace.html web/vite.config.js ./
COPY web/src ./src
COPY web/public ./public
COPY deploy/workspace/csp.mjs /app/csp.mjs
RUN npm run build && node /app/csp.mjs /app/web/dist /app/security-headers.conf

# nginx 1.30.6; the digest also pins the unprivileged image's operating system.
FROM nginxinc/nginx-unprivileged:stable-alpine@sha256:782bb89768cc87b7f95c18b95baa1af250e5d451f26794f59363540161147c01
COPY --from=build /app/web/dist /usr/share/nginx/html
COPY --from=build /app/security-headers.conf /etc/nginx/security-headers.conf
COPY deploy/workspace/nginx.conf /etc/nginx/meridian.conf.template
COPY --chmod=0555 deploy/workspace/entrypoint.sh /usr/local/bin/meridian-web
USER 101:101
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/meridian-web"]
